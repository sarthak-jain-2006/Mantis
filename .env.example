# Copy to .env and fill in. Never commit .env.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=mantis
POSTGRES_PASSWORD=mantis_dev_password
POSTGRES_DB=mantis
POSTGRES_PORT=5433

# --- Node backend ---
DATABASE_URL=postgresql://mantis:mantis_dev_password@localhost:5433/mantis
BACKEND_PORT=3000
AI_SERVICE_URL=http://localhost:8000

# --- Shared secret between Node and Python (generate a long random value) ---
INTERNAL_TOKEN=change-me

# --- Python AI service ---
AI_SERVICE_PORT=8000

# --- LLM (Gemini free tier) ---
# Create a key at https://aistudio.google.com/apikey. Never commit it.
GEMINI_API_KEY=
# The free tier has a daily request limit PER MODEL (shown in AI Studio). One task makes about 10-20
# calls, so "gemini-flash-latest" (20/day on the free tier) allows only one run a day.
# "gemini-flash-lite-latest" has its own, separate allowance (check its limit in AI Studio). Pin a name for repeatable runs.
GEMINI_MODEL=gemini-flash-lite-latest
# Most calls per minute across all running tasks; keep at or below your per-minute quota. 0 = no limit.
LLM_REQUESTS_PER_MINUTE=10
# How long the model thinks per call: minimal | low | medium | high. "low" keeps a turn to a few seconds.
LLM_REASONING_EFFORT=low
# Seconds before a single model call is abandoned.
LLM_TIMEOUT_SECONDS=60

# --- Agent runs ---
# Where the AI service reports run progress (the backend). Use 127.0.0.1, not localhost.
BACKEND_URL=http://127.0.0.1:3000

# --- Repository tools ---
# Only needed if ripgrep isn't on PATH, e.g. RG_PATH=C:\path\to\rg.exe
# RG_PATH=
